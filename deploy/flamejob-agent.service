[Unit]
Description=flamejob GPU worker agent (fj-agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flamejob-agent
# Operator settings (server URL, name, claim token, hashcat) live here.
EnvironmentFile=-/etc/flamejob-agent/agent.env
# The data dir is owned by the flamejob-agent user by the package postinst.
Environment=FJ_AGENT_DATA_DIR=/var/lib/flamejob-agent
ExecStart=/usr/bin/fj-agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
