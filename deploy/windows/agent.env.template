# flamejob-agent configuration (Windows).
# Loaded by fj-agent from %ProgramData%\flamejob-agent\agent.env at startup.
# Point at your control plane and set a one-time claim token for the first start,
# then start the service:  sc start flamejob-agent   (or: fj-agent service start)
FJ_AGENT_SERVER=http://CONTROL-PLANE-HOST:8443
FJ_AGENT_NAME=agent-1
# Obtain from the control plane: POST /admin/agent-claims (needs ManageAgents).
# Needed only for the first start; after enrollment the client certificate
# persists under %ProgramData%\flamejob-agent\pki and you can clear this line.
#FJ_AGENT_CLAIM_TOKEN=
# hashcat executable on this worker (full path, or just hashcat.exe if on PATH).
FJ_AGENT_HASHCAT=hashcat.exe
# hashcat workload profile (1-4).
FJ_AGENT_WORKLOAD=3

# --- GPU fan control -------------------------------------------------------
# Active fan control is Linux-only (it drives nvidia-settings through an Xorg
# server with Coolbits, which Windows has no equivalent for). On Windows the
# agent still reports GPU telemetry via nvidia-smi but leaves fan control to the
# driver / your vendor utility; FJ_AGENT_FAN_CONTROL is ignored here.
