[server]
bind = "0.0.0.0:8443"
# Serve the API directly over HTTPS with a pre-created certificate (e.g. from an
# enterprise CA). Set BOTH or neither. When unset, the API is plain HTTP and TLS
# is expected to be terminated by a reverse proxy (see docs/guides/tls.md).
# tls_cert = "/etc/flamejob/api.crt"
# tls_key  = "/etc/flamejob/api.key"

[database]
# 'local'  = installer manages a Postgres on this box
# 'external' = point at an existing central database via dsn
mode = "local"
dsn  = "postgres://flamejob@localhost/flamejob"
max_connections = 10

[auth]
jwt_secret = "CHANGE-ME"
token_ttl_hours = 1

[hashcat]
binary   = "/usr/bin/hashcat"
data_dir = "/var/lib/flamejob"
workload = 3
# Soft cap on the TOTAL size of all uploaded files (wordlists/rules/masks), in
# bytes. 0 = unlimited (default). When set, an upload that would push the stored
# total past this is rejected (HTTP 507) and the dashboard storage gauge fills
# toward it. This is the cumulative-corpus cap; the per-request upload limit is
# fixed at 8 GiB separately. Example: 500 GiB = 536870912000.
files_quota_bytes = 0

[crypto]
# AD-supplied where available, else generated locally by the installer
plaintext_key_file = "/etc/flamejob/plain.key"

[scheduler]
# keyspace units per chunk; 0 or unknown keyspace = one task
chunk_size = 50000000
max_chunks = 500
# "local" runs hashcat here; "remote" dispatches chunks to enrolled agents
# runner = "local"
# concurrent hashcat processes for the active job on the local runner
# (the remote runner fans across the fleet's advertised slots instead)
# local_parallelism = 1
# how many jobs run at once; their chunks share the fleet's capacity (0 = unlimited)
# max_concurrent_jobs = 8

[web]
# browser dashboard (static SPA that calls the API); mirrors the TUI
enabled = true
bind    = "0.0.0.0:9443"
# set both for HTTPS on `bind`; leave unset for plain HTTP
# tls_cert = "/etc/flamejob/web.crt"
# tls_key  = "/etc/flamejob/web.key"
# Address for the optional HTTPS listener a superadmin/admin enables at runtime
# from Sitewide settings (cert/key are stored in the DB). Additive — `bind` above
# stays HTTP. Binding :443 needs CAP_NET_BIND_SERVICE (see the systemd unit).
# https_bind = "0.0.0.0:443"
# API URL the browser should call (default: derived from page host + API port)
# api_base = "https://flamejob.example/api"
theme = "dark"
# CORS origins allowed to call the API; empty list = any origin
# allowed_origins = ["https://flamejob.example"]
