#!/bin/sh
# flamejob-server postrm: reload systemd on remove; purge config/keys on purge.
set -e

case "$1" in
  remove)
    [ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
    ;;
  purge)
    [ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
    # Generated by postinst (not shipped files), so remove them explicitly.
    rm -f /etc/flamejob/flamejob.toml /etc/flamejob/jwt.key /etc/flamejob/plain.key
    rmdir /etc/flamejob 2>/dev/null || true
    ;;
esac

exit 0
