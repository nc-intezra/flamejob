#!/bin/sh
# flamejob-server prerm: stop and disable the service before files are removed.
set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop flamejob-server.service >/dev/null 2>&1 || true
      systemctl disable flamejob-server.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
