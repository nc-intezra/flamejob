#!/bin/sh
# flamejob-agent postrm: reload systemd on remove; purge the env file on purge.
set -e

case "$1" in
  remove)
    [ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
    ;;
  purge)
    [ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
    # Generated by postinst (not a shipped file), so remove it explicitly.
    # The data dir (/var/lib/flamejob-agent) holds the enrolled cert and is left
    # in place, as the server package leaves its data dir.
    rm -f /etc/flamejob-agent/agent.env
    rmdir /etc/flamejob-agent 2>/dev/null || true
    ;;
esac

exit 0
