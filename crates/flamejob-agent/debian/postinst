#!/bin/sh
# flamejob-agent postinst: system user, data dir, env file, and service enablement.
set -e

CONF_DIR=/etc/flamejob-agent
DATA_DIR=/var/lib/flamejob-agent

case "$1" in
  configure)
    # 1. System user the agent runs as.
    if ! getent passwd flamejob-agent >/dev/null 2>&1; then
      useradd --system --user-group \
        --home-dir "$DATA_DIR" --shell /usr/sbin/nologin flamejob-agent || true
    fi

    # 2. Data dir plus the subdirs the agent writes into (pki, jobs, cache).
    mkdir -p "$DATA_DIR/pki" "$DATA_DIR/jobs" "$DATA_DIR/cache" "$CONF_DIR"

    # 3. Env file — written only if absent, so upgrades and local edits are kept.
    #    The admin points it at the control plane and sets a one-time claim token
    #    for the first start.
    if [ ! -f "$CONF_DIR/agent.env" ]; then
      cat > "$CONF_DIR/agent.env" <<'ENV'
# flamejob-agent configuration (systemd EnvironmentFile).
# Point at your control plane and set a one-time claim token for the first start.
FJ_AGENT_SERVER=http://CONTROL-PLANE-HOST:8443
FJ_AGENT_NAME=agent-1
# Obtain from the control plane: POST /admin/agent-claims (needs ManageAgents).
# Needed only for the first start; after enrollment the cert persists under
# /var/lib/flamejob-agent/pki and you can clear this line.
#FJ_AGENT_CLAIM_TOKEN=
# hashcat binary on this worker.
FJ_AGENT_HASHCAT=/usr/bin/hashcat
# hashcat workload profile (1-4).
FJ_AGENT_WORKLOAD=3

# --- GPU fan control (NVIDIA, opt-in, off by default) -----------------------
# Uncomment to run the closed-loop fan controller while a job runs: it disables
# the driver's auto fan control and holds each GPU's core at FJ_AGENT_FAN_TARGET.
#FJ_AGENT_FAN_CONTROL=true
# Optional tuning (defaults shown):
#FJ_AGENT_FAN_TARGET=75        # core temperature (C) to hold
#FJ_AGENT_FAN_MIN=30           # minimum fan %
#FJ_AGENT_FAN_MAX=100          # maximum fan %
#FJ_AGENT_FAN_DEADBAND=2       # C no-change band around the target
#FJ_AGENT_FAN_DOWN_STEP=5      # max fan %% decrease per tick
#FJ_AGENT_FAN_CRITICAL=        # overheat trip (C); default is just below each
#                              # GPU's rated slowdown temp. At/above it the task
#                              # is stopped and the agent flagged until it cools.
#
# IMPORTANT: nvidia-settings needs a running classic *Xorg* server with Coolbits
# enabled and a DISPLAY this (headless) service can reach. Without the lines below
# fan control silently no-ops (telemetry still works).
#   - It will NOT work against a Wayland session (the default on e.g. Ubuntu
#     22.04+/24.04 with GDM). Use an Xorg login session, or run a dedicated Xorg
#     for the agent: `nvidia-xconfig --enable-all-gpus --cool-bits=28`.
#   - XAUTHORITY has no fixed path; find the live server's auth file with:
#       ps -C Xorg -o args= | grep -o '\-auth[= ][^ ]*'
#     and set XAUTHORITY to that. Ensure the flamejob-agent user can read it
#     (shared XAUTHORITY, or `xhost +si:localuser:flamejob-agent`).
#DISPLAY=:0
#XAUTHORITY=/path/to/Xorg/auth/file   # e.g. from the ps command above
ENV
    fi

    # 4. Ownership and permissions.
    chown -R flamejob-agent:flamejob-agent "$DATA_DIR" "$CONF_DIR" || true
    chmod 640 "$CONF_DIR/agent.env" 2>/dev/null || true

    # 5. Service: reload + enable, but do not start — the control plane URL and a
    #    claim token must be set in the env file first (see the message below).
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl enable flamejob-agent.service >/dev/null 2>&1 || true
    fi

    echo "flamejob-agent installed. Edit $CONF_DIR/agent.env (server URL + claim token),"
    echo "ensure hashcat is installed on this host, then: systemctl start flamejob-agent"
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

exit 0
